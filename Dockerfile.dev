FROM rust:1.97

# Install dependencies
RUN rustup target add wasm32-unknown-unknown
# Keep cargo-leptos aligned with the wasm-bindgen "=0.2.104" pin (0.2.46 -> CLI 0.2.104).
RUN curl --proto '=https' --tlsv1.2 -LsSf https://github.com/leptos-rs/cargo-leptos/releases/download/v0.2.46/cargo-leptos-installer.sh | sh

WORKDIR /app

# Expose both the application port and hot-reload port
EXPOSE 3000
EXPOSE 3001

# Set environment variables for development
ENV RUST_LOG="debug"

# Build the CSS bundle from its parts, then run cargo-leptos from the app crate.
CMD ["sh", "-c", "cat apps/backend/style/parts/*.css > apps/backend/style/main.css && cd apps/backend && cargo leptos watch --hot-reload"]
